{
  "name": "connect-suite",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:appkit",
    "build:lib": "pnpm -r --filter \"./packages/lib/packages/*\" build",
    "build:appkit": "pnpm -r --filter \"./packages/appkit/packages/*\" build",
    "clean": "pnpm -r clean",
    "test:run": "pnpm run test:lib && pnpm run test:appkit",
    "test:lib": "pnpm --dir packages/lib exec vitest run",
    "test:appkit": "pnpm --dir packages/appkit exec vitest run",
    "test:matrix": "node scripts/dependency-matrix.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "typecheck": "tsc --noEmit -p packages/lib/tsconfig.json && tsc --noEmit -p packages/appkit/tsconfig.json",
    "lint": "pnpm --dir packages/lib exec biome lint && pnpm --dir packages/appkit exec biome lint",
    "preflight:lib": "node packages/lib/scripts/release-preflight.mjs",
    "preflight:appkit": "node packages/appkit/scripts/release-preflight.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.59.4",
    "@reown/appkit": "^1.8.23",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.3.4",
    "jscpd": "^5.4.1",
    "jsdom": "^30.0.1",
    "semver": "^7.8.5",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "viem": "^2.57.7",
    "vitest": "^5.0.5",
    "wagmi": "^3.7.7"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16"
  },
  "engines": {
    "node": ">=22"
  }
}
