    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naculus-official/connect-suite.git",
    "directory": "packages/lib/packages/connector-solana"
  },
  "license": "MIT",
  "keywords": [
    "web3",
    "solana",
    "wallet"
  ],
  "description": "Solana wallet connector (Wallet Standard)",
  "homepage": "https://github.com/naculus-official/connect-suite/tree/dev/packages/lib/packages/connector-solana#readme",
  "bugs": {
    "url": "https://github.com/naculus-official/connect-suite/issues"
  }
