{
  "name": "@naculus/connector-solana",
  "version": "0.15.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "sideEffects": false,
  "dependencies": {
    "@naculus/connect-core": "workspace:*"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
