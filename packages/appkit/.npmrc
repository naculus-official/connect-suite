# ── GitHub Packages (uncomment when needed) ─────────────────────
# @naculus:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# ── General ────────────────────────────────────────────────────
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=30000
