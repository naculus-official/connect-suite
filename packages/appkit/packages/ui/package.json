{
  "name": "@naculus/connect-appkit-ui",
  "version": "0.15.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "default": "./dist/styles/index.css"
    },
    "./styles/components": {
      "default": "./dist/styles/components.css"
    },
    "./styles/preflight": {
      "default": "./dist/styles/preflight.css"
    },
    "./styles/utilities": {
      "default": "./dist/styles/utilities.css"
    },
    "./styles/tokens": {
      "default": "./dist/styles/tokens.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles/components.css -o dist/styles/components.css --minify && tailwindcss -i src/styles/preflight.css -o dist/styles/preflight.css --minify && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@naculus/siwx": "workspace:^",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@naculus/connect-appkit-core": "^0.15.0",
    "@naculus/connect-appkit-react": "^0.15.0",
    "@naculus/connect-core": "^0.15.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@naculus/connect-appkit-core": "workspace:*",
    "@naculus/connect-appkit-react": "workspace:*",
    "@naculus/connect-core": "workspace:^",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/naculus-official/connect-suite.git",
    "directory": "packages/appkit/packages/ui"
  },
  "license": "MIT",
  "description": "Naculus Connect UI — base styles, CSS tokens, and legacy shadcn contexts",
  "homepage": "https://github.com/naculus-official/connect-suite/tree/dev/packages/appkit/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/naculus-official/connect-suite/issues"
  },
  "keywords": [
    "web3",
    "wallet",
    "connect",
    "ui",
    "design-tokens",
    "css"
  ]
}
