    "@naculus/connector-wagmi": "file:../../artifacts/naculus-connector-wagmi-0.2.0.tgz",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.0.0",
    "wagmi": "^3.7.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
